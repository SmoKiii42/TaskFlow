<Window x:Class="TaskFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:menu="clr-namespace:TaskFlow.ViewsSettings"
        mc:Ignorable="d"
        Title="TaskFlow"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E2E">

        <!-- Основной контент -->
        <Frame x:Name="MainFrame"
               NavigationUIVisibility="Hidden"/>

        <!-- Затемнение -->
        <Border x:Name="Overlay"
        Background="#01000000"
        Visibility="Collapsed"
        MouseLeftButtonDown="Overlay_MouseLeftButtonDown"/>

        <!-- Выезжающее меню -->
        <menu:Menu x:Name="MenuPanel"
           HorizontalAlignment="Left" Margin="-16,0,0,0" Width="318"/>

    </Grid>

</Window>