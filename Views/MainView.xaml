<UserControl x:Class="TaskFlow.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#0D0D0D">


    <UserControl.Resources>


        <!-- ICON BUTTON -->

        <Style TargetType="Button" x:Key="IconButtonStyle">

            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>


            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#2A2A2A"/>

                </Trigger>


                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#333333"/>

                </Trigger>


            </Style.Triggers>


        </Style>




        <!-- CREATE BUTTON -->


        <Style TargetType="Button" x:Key="PrimaryButtonStyle">

            <Setter Property="Background"
                    Value="#00A86B"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Height"
                    Value="48"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>


        </Style>




        <!-- DELETE BUTTON -->


        <Style TargetType="Button"
               x:Key="DeleteButtonStyle">


            <Setter Property="Background"
                    Value="#E74C3C"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Width"
                    Value="140"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">


                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">


                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>


                        </Border>


                    </ControlTemplate>


                </Setter.Value>


            </Setter>


        </Style>





        <!-- WORKSPACE CARD -->

        <Style TargetType="Border"
       x:Key="WorkspaceCardStyle">

            <Setter Property="Margin" Value="25,0,25,12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="BorderThickness" Value="1"/>


            <Style.Resources>

                <Style TargetType="Button"
               x:Key="DeleteInsideCardStyle">

                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Visibility" Value="Collapsed"/>

                </Style>

            </Style.Resources>


            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                 Value="True">

                    <Setter Property="Background"
                    Value="#1A1A1A"/>

                    <Setter Property="BorderBrush"
                    Value="#333333"/>

                </Trigger>


            </Style.Triggers>


        </Style>


    </UserControl.Resources>





    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF071F03" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="25,20,25,15">


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>



            <StackPanel>


                <DockPanel>


                    <Button x:Name="MenuButton"
                            Style="{StaticResource IconButtonStyle}"
                            Content="☰"
                            Click="MenuButton_Click"
                            Margin="0,0,15,0"/>



                    <TextBlock Text="Welcome"
                               VerticalAlignment="Center"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"/>


                </DockPanel>



                <TextBlock Text="Manage all your workspaces in one place."
                           Margin="57,5,0,0"
                           FontSize="15"
                           Foreground="#888888"/>


            </StackPanel>




            <Button Grid.Column="1"
                    x:Name="CreateWorkspaceButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="190"
                    Content="+ Create Workspace"
                    Click="CreateWorkspaceButton_Click"/>


        </Grid>





        <!-- WORKSPACES -->


        <Grid Grid.Row="1">


            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>




            <TextBlock Grid.Row="0"
                       Text="My Workspaces"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="25,0,0,20"
                       Foreground="White"/>





            <ListView Grid.Row="1"
                      x:Name="WorkspaceList"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="0,0,0,10"
                      SelectionChanged="WorkspaceList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">



                <ListView.ItemTemplate>


                    <DataTemplate>



                        <Border x:Name="WorkspaceCard"
                                Style="{StaticResource WorkspaceCardStyle}">



                            <Grid>



                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="65"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>





                                <!-- ICON -->


                                <Border Width="55"
                                        Height="55"
                                        Background="#1A3A1A"
                                        CornerRadius="14"
                                        VerticalAlignment="Center">


                                    <TextBlock Text="📁"
                                               FontSize="26"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>


                                </Border>






                                <!-- TEXT -->


                                <StackPanel Grid.Column="1"
                                            Margin="18,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">


                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>




                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,5,0,10"
                                               FontSize="14"
                                               Foreground="#888888"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"
                                               TextTrimming="WordEllipsis"/>




                                    <!-- DELETE BUTTON -->


                                    <Button x:Name="DeleteButton"
        Style="{StaticResource DeleteButtonStyle}"
        Content="Delete Workspace"
        Click="DeleteSpace_Click"
        HorizontalAlignment="Left"
        Margin="0,5,0,0"/>



                                </StackPanel>






                                <!-- ARROW -->


                                <Border Grid.Column="2"
                                        Width="40"
                                        Height="40"
                                        Background="#1A1A1A"
                                        CornerRadius="10"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">



                                    <TextBlock Text="→"
                                               FontSize="20"
                                               Foreground="#888888"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>



                                </Border>




                            </Grid>



                        </Border>



                    </DataTemplate>



                </ListView.ItemTemplate>




            </ListView>



        </Grid>




    </Grid>


</UserControl>