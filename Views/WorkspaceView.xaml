<UserControl x:Class="TaskFlow.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1A1A1A">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                    Background="#252525">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock x:Name="WorkspaceName"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                    <TextBlock x:Name="WorkspaceDescription"
                                   FontSize="14"
                                   Foreground="#AAAAAA"/>

                </StackPanel>

                <Button Grid.Column="1"
                            Height="42"
                            Margin="0,0,10,0"
                            Content="+ Новая задача"
                            Background="#00A86B"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="AddTask_Click"/>

                <Button Grid.Column="2"
                            Height="42"
                            Content="Назад"
                            Background="#3A3A3A"
                            Foreground="#AAAAAA"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="BackButton_Click"/>

            </Grid>

        </Border>

        <!-- CONTENT -->

        <Grid Grid.Row="1"
                  Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- TASKS -->

            <Border Grid.Column="0"
        Background="#252525"
        CornerRadius="15"
        Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->

                    <TextBlock Grid.Row="0"
                   Text="✅ Задачи"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,15"/>

                    <!-- Список задач -->

                    <ListBox Grid.Row="1"
                 x:Name="TaskList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>

                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border x:Name="TaskCard"
                            Background="#2A2A2A"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="15">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Title}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                                        <TextBlock Text="{Binding Description}"
                                       Margin="0,6,0,0"
                                       Foreground="#AAAAAA"
                                       TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">

                                            <TextBlock Text="Статус:"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                            <TextBlock Text="{Binding Status}"
                                           Margin="5,0,20,0"
                                           Foreground="#AAAAAA"/>

                                            <TextBlock Text="дата создания:"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                            <TextBlock Text="{Binding DueDate,
                                                  StringFormat={}{0:dd.MM.yyyy}}"
                                           Margin="5,0,0,0"
                                           Foreground="#AAAAAA"/>
                                            
                                            <Button Content="Удалить"
                                                    Height="28"
                                                    Margin="20,0,0,0"
                                                    Background="#EF4444"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Click="DeleteTask_Click"/>

                                        </StackPanel>

                                    </StackPanel>

                                </Border>

                                <DataTemplate.Triggers>

                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                       Path=IsMouseOver}"
                                     Value="True">

                                        <Setter TargetName="TaskCard"
                                    Property="Background"
                                    Value="#313131"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                       Path=IsSelected}"
                                     Value="True">

                                        <Setter TargetName="TaskCard"
                                    Property="Background"
                                    Value="#333333"/>

                                        <Setter TargetName="TaskCard"
                                    Property="BorderBrush"
                                    Value="#00A86B"/>

                                        <Setter TargetName="TaskCard"
                                    Property="BorderThickness"
                                    Value="2"/>

                                    </DataTrigger>

                                </DataTemplate.Triggers>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>
            <!-- RIGHT PANEL -->

            <StackPanel Grid.Column="1"
                        Margin="20,0,0,0">

                <!-- INFO -->

                <Border Background="#252525"
                        CornerRadius="15"
                        Padding="20"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="ℹ Информация"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Выберите задачу из списка"
                                   Foreground="#AAAAAA"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <!-- MEMBERS -->

                <Border Background="#252525"
                        CornerRadius="15"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="👥 Участники"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,15"/>

                        <ListBox x:Name="MembersList"
                                 Background="Transparent"
                                 BorderThickness="0">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border Background="#2A2A2A"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,5">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>

                                                <TextBlock Text="{Binding User.FirstName}"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>

                                                <TextBlock Text="{Binding Role}"
                                                           FontSize="12"
                                                           Foreground="#AAAAAA"/>

                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Удалить"
                                                    Height="32"
                                                    Margin="5"
                                                    Background="#EF4444"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Click="RemoveMember_Click"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>