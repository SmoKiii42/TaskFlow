<UserControl x:Class="TaskFlow.ViewsSettings.profile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="586">


    <UserControl.Resources>


        <!-- Button Style -->

        <Style TargetType="Button">

            <Setter Property="Height"
                    Value="45"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Cursor"
                    Value="Hand"/>


            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Opacity"
                            Value="0.85"/>

                </Trigger>


            </Style.Triggers>


        </Style>


    </UserControl.Resources>





    <Grid Background="#1A1A1A"
          Margin="35">



        <Grid.RowDefinitions>

            <RowDefinition Height="220"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>





        <!-- PROFILE HEADER -->


        <Border Grid.Row="0"
                Background="#252525"
                CornerRadius="18">


            <Grid Margin="30">


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="170"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>





                <!-- IMAGE -->


                <Border Width="140"
                        Height="140"
                        CornerRadius="70"
                        Background="#2563EB"
                        MouseLeftButtonDown="ProfileImage_Click"
                        VerticalAlignment="Center">


                    <Image x:Name="ProfileImage"
                           Stretch="UniformToFill"/>


                </Border>





                <!-- USER INFO -->


                <StackPanel Grid.Column="1"
                            Margin="25,0,0,0"
                            VerticalAlignment="Center">


                    <TextBlock x:Name="UserName"
                               Text="{Binding FirstName}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"/>




                    <TextBlock x:Name="UserDescription"
                               Text="{Binding Description}"
                               Margin="0,12,0,0"
                               FontSize="16"
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"/>





                    <Border Margin="0,20,0,0"
                            Background="#2A2A2A"
                            CornerRadius="10"
                            Padding="12,7"
                            HorizontalAlignment="Left">


                        <TextBlock x:Name="UserId"
                                   Text="{Binding Id, StringFormat=ID: {0}}"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>


                    </Border>


                </StackPanel>


            </Grid>


        </Border>






        <!-- BOTTOM -->


        <Grid Grid.Row="1"
              Margin="0,25,0,0">


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>





            <!-- ACCOUNT INFO -->


            <Border Background="#252525"
                    CornerRadius="18"
                    Padding="25"
                    Margin="0,0,20,0">


                <StackPanel>


                    <TextBlock Text="Account Information"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,20"/>




                    <TextBlock Text="Email"
                               Foreground="#AAAAAA"/>


                    <TextBlock x:Name="EmailText"
                               Text="{Binding Email}"
                               FontSize="16"
                               Foreground="White"
                               Margin="0,5,0,18"/>





                    <TextBlock Text="Role"
                               Foreground="#AAAAAA"/>


                    <TextBlock x:Name="RoleText"
                               Text="{Binding Role}"
                               FontSize="16"
                               Foreground="White"
                               Margin="0,5,0,0"/>


                </StackPanel>


            </Border>








            <!-- ACTION BUTTONS -->


            <StackPanel Grid.Column="1">



                <Button x:Name="EditProfile_Button"
                        Background="#2563EB"
                        Content="Edit Profile"
                        Click="EditProfile_Button_Click"/>



                <Button Margin="0,15,0,0"
                        Background="#00A86B"
                        Content="Change Photo"
                        Click="Button_Click"/>




                <Button Margin="0,15,0,0"
                        Background="#DC2626"
                        Content="Delete Account"
                        Click="DeletAcc_Click"/>




                <Button Margin="0,25,0,0"
                        Width="120"
                        HorizontalAlignment="Right"
                        Background="#3A3A3A"
                        Content="Back"
                        Click="BackToMainV_Click"/>



            </StackPanel>




        </Grid>




    </Grid>



</UserControl>