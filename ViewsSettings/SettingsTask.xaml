<UserControl x:Class="TaskFlow.ViewsSettings.SettingsTask"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <UserControl.Resources>


        <!-- Button Style -->

        <Style TargetType="Button">

            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>


            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>

            </Style.Triggers>


        </Style>



        <!-- Checkbox -->

        <Style TargetType="CheckBox">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>

        </Style>



    </UserControl.Resources>




    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="#1A1A1A">


        <Grid Background="#1A1A1A"
              Margin="40">


            <StackPanel>



                <!-- HEADER -->


                <TextBlock Text="Settings"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"/>


                <TextBlock Text="Manage your application preferences"
                           Margin="0,5,0,35"
                           Foreground="#AAAAAA"
                           FontSize="15"/>





                <!-- ACCOUNT -->


                <Border Background="#252525"
                        CornerRadius="18"
                        Padding="25"
                        Margin="0,0,0,20">


                    <StackPanel>


                        <TextBlock Text="👤 Account"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>


                        <TextBlock Text="Manage your account"
                                   Margin="0,5,0,20"
                                   Foreground="#AAAAAA"/>



                        <Button Content="Change Password"
                                Background="#2563EB"
                                Click="ChangePassword_Click"
                                Margin="0,0,0,10"/>



                        <Button Content="Change Email"
                                Background="#2563EB"
                                Click="ChengeEmail_Click"
                                Margin="0,0,0,10"/>



                        <Button Content="Logout"
                                Background="#D97706"
                                Click="Logout_Click"
                                Margin="0,0,0,10"/>



                        <Button Content="Delete Account"
                                Background="#DC2626"
                                Click="DeleteAccount_Click"/>


                    </StackPanel>


                </Border>







                <!-- APPEARANCE -->


                <Border Background="#252525"
                        CornerRadius="18"
                        Padding="25"
                        Margin="0,0,0,20">


                    <StackPanel>


                        <TextBlock Text="🎨 Appearance"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>


                        <TextBlock Text="Customize application look"
                                   Margin="0,5,0,20"
                                   Foreground="#AAAAAA"/>



                        <CheckBox Content="Dark Theme"
                                  Margin="0,0,0,12"/>



                        <CheckBox Content="Light Theme"/>


                    </StackPanel>


                </Border>







                <!-- NOTIFICATIONS -->


                <Border Background="#252525"
                        CornerRadius="18"
                        Padding="25"
                        Margin="0,0,0,20">


                    <StackPanel>


                        <TextBlock Text="🔔 Notifications"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>


                        <TextBlock Text="Notification settings"
                                   Margin="0,5,0,20"
                                   Foreground="#AAAAAA"/>



                        <CheckBox Content="Desktop notifications"
                                  Margin="0,0,0,12"/>


                        <CheckBox Content="Sound"/>


                    </StackPanel>


                </Border>







                <!-- ABOUT -->


                <Border Background="#252525"
                        CornerRadius="18"
                        Padding="25"
                        Margin="0,0,0,20">


                    <StackPanel>


                        <TextBlock Text="ℹ About"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>



                        <TextBlock Text="TaskFlow"
                                   Margin="0,20,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>



                        <TextBlock Text="Version 1.0"
                                   Margin="0,6,0,0"
                                   Foreground="#AAAAAA"/>



                        <TextBlock Text="Created by SmoKiii"
                                   Margin="0,6,0,0"
                                   Foreground="#AAAAAA"/>



                        <TextBlock Text="Telegramm: @Wind_up24"
                                   Margin="0,6,0,0"
                                   Foreground="#AAAAAA"/>


                    </StackPanel>


                </Border>





                <!-- BACK -->


                <Button Height="45"
                        Background="#3A3A3A"
                        Content="Back"
                        Click="BackButtom_Click"/>



            </StackPanel>



        </Grid>


    </ScrollViewer>


</UserControl>