<UserControl x:Class="TaskFlow.ViewsSettings.Friends"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">


    <UserControl.Resources>


        <!-- TextBox -->

        <Style TargetType="TextBox">

            <Setter Property="Background"
                    Value="#2A2A2A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#3A3A3A"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="CaretBrush"
                    Value="White"/>

        </Style>



        <!-- Buttons -->

        <Style TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


    </UserControl.Resources>



    <Grid Background="#1A1A1A">


        <Grid Margin="40">


            <StackPanel>



                <!-- Header -->


                <TextBlock Text="Friends"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"/>


                <TextBlock Text="Manage friends and workspace invitations"
                           Margin="0,5,0,30"
                           Foreground="#AAAAAA"
                           FontSize="15"/>



                <!-- Add Friend -->


                <Border Background="#252525"
                        CornerRadius="15"
                        Padding="25"
                        Margin="0,0,0,20">


                    <StackPanel>


                        <TextBlock Text="➕ Add Friend"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>


                        <TextBlock Text="Enter user ID to send friend request"
                                   Margin="0,5,0,20"
                                   Foreground="#AAAAAA"/>



                        <Grid>


                            <Grid.ColumnDefinitions>

                                <ColumnDefinition/>

                                <ColumnDefinition Width="120"/>

                            </Grid.ColumnDefinitions>



                            <TextBox x:Name="FriendIdBox"
                                     Height="42"
                                     Margin="0,0,10,0"
                                     TextChanged="FriendIdBox_TextChanged"/>



                            <Button Grid.Column="1"
                                    Content="Send"
                                    Background="#2563EB"
                                    Foreground="White"
                                    Click="SendFriend_Click"/>


                        </Grid>


                    </StackPanel>


                </Border>




                <!-- Friends List -->


                <Border Background="#252525"
                        CornerRadius="15"
                        Padding="25">


                    <StackPanel>


                        <TextBlock Text="👥 My Friends"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>


                        <ListBox x:Name="FriendsList"
                                 Margin="0,20,0,0"
                                 Background="Transparent"
                                 BorderThickness="0">


                            <ListBox.ItemTemplate>


                                <DataTemplate>

                                    <Border Background="#2A2A2A"
            CornerRadius="12"
            Padding="15"
            Margin="0,5">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <!-- Текст -->
                                                <ColumnDefinition Width="*"/>

                                                <!-- Invite -->
                                                <ColumnDefinition Width="100"/>

                                                <!-- Delete -->
                                                <ColumnDefinition Width="100"/>

                                            </Grid.ColumnDefinitions>


                                            <!-- Данные друга -->

                                            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                                                <TextBlock Text="{Binding FirstName}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>


                                                <TextBlock Text="{Binding Email}"
                           Foreground="#AAAAAA"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>



                                            <!-- Invite -->

                                            <Button Grid.Column="1"
                    Content="Invite"
                    Height="35"
                    Margin="5,0"
                    Background="#7C3AED"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="InviteWorkspace_Click"/>



                                            <!-- Delete friend -->

                                            <Button Grid.Column="2"
                    Content="Delete"
                    Height="35"
                    Margin="5,0"
                    Background="#DC2626"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DeleteFriend_Click"/>


                                        </Grid>


                                    </Border>


                                </DataTemplate>


                            </ListBox.ItemTemplate>


                        </ListBox>


                    </StackPanel>


                </Border>

                <!-- Friend Requests -->


                <Border Background="#252525"
        CornerRadius="15"
        Padding="25"
        Margin="0,20,0,0">


                    <StackPanel>


                        <TextBlock Text="📩 Friend Requests"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="White"/>



                        <ListBox x:Name="RequestsList"
                 Margin="0,20,0,0"
                 Background="Transparent"
                 BorderThickness="0">


                            <ListBox.ItemTemplate>


                                <DataTemplate>


                                    <Border Background="#2A2A2A"
                            CornerRadius="12"
                            Padding="15"
                            Margin="0,5">


                                        <Grid>


                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition/>

                                                <ColumnDefinition Width="100"/>

                                                <ColumnDefinition Width="100"/>

                                            </Grid.ColumnDefinitions>



                                            <TextBlock Text="{Binding Sender.FirstName}"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>



                                            <Button Grid.Column="1"
                                    Content="Accept"
                                    Background="#00A86B"
                                    Foreground="White"
                                    Margin="5,0"
                                    Click="AcceptFriend_Click"/>



                                            <Button Grid.Column="2"
                                    Content="Decline"
                                    Background="#EF4444"
                                    Foreground="White"
                                    Margin="5,0,0,0"
                                    Click="DeclineFriend_Click"/>


                                        </Grid>


                                    </Border>


                                </DataTemplate>


                            </ListBox.ItemTemplate>


                        </ListBox>


                    </StackPanel>


                </Border>





                <!-- Workspace Invitations -->


                <Border Background="#252525"
        CornerRadius="15"
        Padding="25"
        Margin="0,20,0,20">


                    <StackPanel>


                        <TextBlock Text="📂 Workspace Invitations"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="White"/>



                        <TextBlock Text="Invitations to join workspace"
                   Margin="0,5,0,20"
                   Foreground="#AAAAAA"/>




                        <ListBox x:Name="WorkspaceInviteList"
                 Background="Transparent"
                 BorderThickness="0">


                            <ListBox.ItemTemplate>


                                <DataTemplate>


                                    <Border Background="#2A2A2A"
                            CornerRadius="12"
                            Padding="15"
                            Margin="0,5">


                                        <Grid>


                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition/>

                                                <ColumnDefinition Width="100"/>

                                                <ColumnDefinition Width="100"/>

                                            </Grid.ColumnDefinitions>



                                            <StackPanel>


                                                <TextBlock Text="{Binding Workspace.Name}"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>



                                                <TextBlock Text="{Binding Sender.FirstName}"
                                           Foreground="#AAAAAA"
                                           FontSize="13"/>


                                            </StackPanel>




                                            <Button Grid.Column="1"
                                    Content="Accept"
                                    Background="#00A86B"
                                    Foreground="White"
                                    Margin="5,0"
                                    Click="AcceptWorkspaceInvite_Click"/>



                                            <Button Grid.Column="2"
                                    Content="Decline"
                                    Background="#EF4444"
                                    Foreground="White"
                                    Margin="5,0,0,0"
                                    Click="DeclineWorkspaceInvite_Click"/>


                                        </Grid>


                                    </Border>


                                </DataTemplate>


                            </ListBox.ItemTemplate>


                        </ListBox>


                    </StackPanel>


                </Border>





                <!-- Back Button -->


                <Button Content="Back"
        Height="42"
        Width="120"
        HorizontalAlignment="Right"
        Background="#3A3A3A"
        Foreground="White"
        Click="BackButton_Click"/>


            </StackPanel>

        </Grid>

    </Grid>

</UserControl>