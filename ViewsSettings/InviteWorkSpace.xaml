<UserControl x:Class="TaskFlow.ViewsSettings.InviteWorkSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <UserControl.Resources>


        <!-- Buttons -->

        <Style TargetType="Button">

            <Setter Property="Height"
                    Value="45"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


    </UserControl.Resources>



    <Grid Background="#1A1A1A">


        <Border Width="650"
                Background="#252525"
                Padding="35"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">


            <StackPanel>



                <!-- Header -->


                <TextBlock Text="Invite Friend"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"/>


                <TextBlock Text="Choose workspace to share"
                           Margin="0,8,0,30"
                           FontSize="16"
                           Foreground="#AAAAAA"/>



                <!-- Friend -->


                <TextBlock Text="Friend"
                           FontSize="16"
                           Foreground="#AAAAAA"
                           FontWeight="SemiBold"/>


                <Border Margin="0,8,0,25"
                        Padding="15"
                        Background="#2A2A2A"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        CornerRadius="12">


                    <StackPanel Orientation="Horizontal">


                        <TextBlock Text="{Binding FirstName}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>


                        <TextBlock Text=" "
                                   Width="10"/>


                        <TextBlock Text="{Binding Email}"
                                   VerticalAlignment="Center"
                                   Foreground="#AAAAAA"/>


                    </StackPanel>


                </Border>




                <!-- Workspace -->


                <TextBlock Text="Workspace"
                           FontSize="16"
                           Foreground="#AAAAAA"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>



                <ListBox x:Name="WorkspaceList"
                         Height="250"
                         Background="Transparent"
                         BorderThickness="0">


                    <ListBox.ItemTemplate>


                        <DataTemplate>


                            <Border Background="#2A2A2A"
                                    BorderBrush="#3A3A3A"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="15"
                                    Margin="0,5">


                                <StackPanel>


                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="White"/>


                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,6,0,0"
                                               Foreground="#AAAAAA"
                                               TextWrapping="Wrap"/>


                                </StackPanel>


                            </Border>


                        </DataTemplate>


                    </ListBox.ItemTemplate>


                </ListBox>





                <!-- Buttons -->


                <Grid Margin="0,30,0,0">


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition Width="15"/>

                        <ColumnDefinition/>

                    </Grid.ColumnDefinitions>




                    <Button Grid.Column="0"
                            Content="Cancel"
                            Background="#3A3A3A"
                            Foreground="#AAAAAA"
                            Click="Cancel_Click"/>




                    <Button Grid.Column="2"
                            Content="Send Invite"
                            Background="#00A86B"
                            Foreground="White"
                            Click="SendInvite_Click"/>


                </Grid>


            </StackPanel>


        </Border>


    </Grid>


</UserControl>