<UserControl x:Class="TaskFlow.ViewsSettings.ChangePassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskFlow.ViewsSettings"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="45"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#1A1A1A">

        <Border Width="550"
                Background="#252525"
                CornerRadius="15"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Header -->

                <TextBlock Text="Change Password"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Update your account password"
                           Margin="0,8,0,30"
                           FontSize="18"
                           Foreground="#AAAAAA"/>

                <!-- Current Password -->

                <TextBlock Text="Current Password"
                           Foreground="#AAAAAA"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="CurrentPasswordBox"
                             Margin="0,0,0,20"/>
               

                <!-- Buttons -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Content="Cancel X"
                            Background="#3A3A3A"
                            Foreground="#AAAAAA"
                            Click="CancelButton_Click"/>

                    <Button x:Name="SaveButton"
                            Grid.Column="2"
                            Content="Check ->"
                            Background="#00A86B"
                            Foreground="White"
                            Click="SaveButton_Click"/>

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>