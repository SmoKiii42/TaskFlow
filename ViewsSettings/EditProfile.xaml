<UserControl x:Class="TaskFlow.ViewsSettings.EditProfile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskFlow.ViewsSettings"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- TextBox -->

        <Style TargetType="TextBox">

            <Setter Property="Background"
                    Value="#2A2A2A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#3A3A3A"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="CaretBrush"
                    Value="White"/>

        </Style>


        <!-- Buttons -->

        <Style TargetType="Button">

            <Setter Property="Height"
                    Value="50"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </UserControl.Resources>


    <Grid Background="#1A1A1A">

        <Border Width="600"
                Background="#252525"
                CornerRadius="15"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">


            <StackPanel>


                <!-- Header -->

                <TextBlock Text="Edit Profile"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"/>


                <TextBlock Text="Change your personal information"
                           Margin="0,8,0,30"
                           FontSize="18"
                           Foreground="#AAAAAA"/>



                <!-- First Name -->

                <TextBlock Text="First Name"
                           Foreground="#AAAAAA"
                           FontSize="16"
                           Margin="0,0,0,8"/>


                <TextBox x:Name="FirstNameBox"
                         Height="45"
                         Margin="0,0,0,18"/>



                <!-- Last Name -->

                <TextBlock Text="Last Name"
                           Foreground="#AAAAAA"
                           FontSize="16"
                           Margin="0,0,0,8"/>


                <TextBox x:Name="LastNameBox"
                         Height="45"
                         Margin="0,0,0,18"/>



                <!-- Description -->

                <TextBlock Text="Description"
                           Foreground="#AAAAAA"
                           FontSize="16"
                           Margin="0,0,0,8"/>


                <TextBox x:Name="DescriptionBox"
                         Height="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,30"/>



                <!-- Buttons -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>



                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Content="Cancel"
                            Background="#3A3A3A"
                            Foreground="#AAAAAA"
                            Click="CancelButton_Click"/>



                    <Button x:Name="SaveButton"
                            Grid.Column="2"
                            Content="Save Changes"
                            Background="#00A86B"
                            Foreground="White"
                            Click="SaveButton_Click"/>


                </Grid>


            </StackPanel>


        </Border>


    </Grid>


</UserControl>